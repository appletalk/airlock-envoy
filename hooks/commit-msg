#!/usr/bin/env bash
# airlock-envoy commit-msg: this repo is public, so no site details in a commit message
# (scripts/private-names-check). Install with: git config core.hooksPath hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
rc=0; scripts/private-names-check --msg "$1" || rc=$?
[ "$rc" = 2 ] && { echo "!! private-names-check could not run (above): the message was not checked" >&2; exit 0; }
exit "$rc"
