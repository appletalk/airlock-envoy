[Unit]
Description=Lock the airlock Envoy pass credentials at the unlock's deadline
Documentation=https://github.com/appletalk/airlock-envoy

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/airlock-envoy-cred expire
UMask=0077

NoNewPrivileges=yes
# SETUID/SETGID: to mark GitHub App tokens locked as the mint account (setpriv); the mint's /run:
# to drop unlocked App keys and mark their tokens (absent when no App is set up).
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
ProtectSystem=strict
ReadWritePaths=/run/airlock-envoy-cred -/run/airlock-envoy-mint
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
