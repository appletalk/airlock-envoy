[Unit]
Description=airlock Envoy web egress (public internet only, behind airlock-envoy)
Documentation=https://github.com/appletalk/airlock-envoy
Wants=network-online.target
After=network-online.target
# The kill switch (airlock-envoy-apply --stop): not even a box connection starts it.
ConditionPathExists=!/etc/airlock-envoy/stopped
# Never give up restarting after failures (see RestartSteps= below).
StartLimitIntervalSec=0

[Service]
Type=simple
User=airlock-envoy
Group=airlock-envoy
# The kernel filter below must be enforced, or web would reach every address: systemd accepts
# IPAddressDeny and silently does nothing where cgroup BPF is missing (some containers, old
# kernels). So the start fails unless a connect to a denied address (loopback, port 9) gets
# EPERM from the kernel. Only a root-written drop-in can skip this (the install test does,
# inside a container), and the skip is logged.
ExecStartPre=/bin/bash -c 'if [ "$${AIRLOCK_ENVOY_WEB_FILTER_CHECK:-}" = skip ]; then echo "airlock-envoy-web: WARNING: kernel filter check skipped (AIRLOCK_ENVOY_WEB_FILTER_CHECK=skip)" >&2; exit 0; fi; out=$$( { exec 3<>/dev/tcp/127.0.0.2/9; } 2>&1 ); case "$$out" in *"Operation not permitted"*) exit 0 ;; esac; echo "airlock-envoy-web: the kernel IP filter is not enforced on this host (a connect to 127.0.0.2:9 gave: $${out:-success}); not starting web" >&2; exit 1'
# Rendered from /etc/airlock-envoy/site.conf by airlock-envoy-apply, which starts this unit only
# while some listener lists web.
ExecStart=/usr/local/bin/envoy -c /etc/airlock-envoy/envoy-web.yaml --disable-hot-restart --file-flush-interval-msec 1000 --log-level warn
# Ready only once all of Envoy's sockets (every listener's, and admin) exist, so a start or
# restart returns when connections work and the relays (ordered after this unit) never meet a
# missing socket. A config it cannot read, or one naming no sockets, fails the start, and so
# does Envoy exiting (at once, not after the 10 s the wait allows).
ExecStartPost=/bin/sh -c 'socks=$$(grep -o "/run/airlock-envoy-web/[a-z0-9-]*[.]sock" /etc/airlock-envoy/envoy-web.yaml) || exit 1; i=0; for s in $$socks; do until [ -S "$$s" ]; do kill -0 "$$MAINPID" 2>/dev/null || exit 1; i=$$((i+1)); [ $$i -lt 200 ] || exit 1; sleep 0.05; done; done'
Restart=on-failure
RestartSec=2
# Back off to a minute between tries rather than stop trying: after a crash loop Envoy comes
# back by itself once the cause is gone, and the box sockets stay up meanwhile (the relay only
# Wants= Envoy). Box egress is closed while it is down. RestartSteps= needs systemd 254 or
# later; older ones ignore it and retry every 2 s.
RestartSteps=10
RestartMaxDelaySec=60

# Its sockets are reached only by the main Envoy (same account); no box socket leads here. The
# other way round stays shut: the main Envoy's sockets (its admin, every listener, internal
# destinations included) are out of this unit's sight, so a compromised web Envoy can't use
# them to get around its kernel filter.
RuntimeDirectory=airlock-envoy-web
InaccessiblePaths=-/run/airlock-envoy-internal -/run/airlock-envoy
RuntimeDirectoryMode=0700
# The audit log: readable by root and this service only.
LogsDirectory=airlock-envoy
LogsDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Web means the public internet: every address that is not public is refused in the kernel,
# whatever a name resolves to. The site adds its own internal ranges, and allows its resolvers
# by exact address, in airlock-envoy-web.service.d/site.conf (airlock-envoy-apply). Without
# that drop-in this list still holds: even a loopback resolver is refused, so it fails closed.
# IPv4: this network, private, CGNAT, loopback, link-local, IETF protocol, documentation,
# 6to4 relay, benchmarking, multicast, reserved and broadcast.
IPAddressDeny=0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12
IPAddressDeny=192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15
IPAddressDeny=198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4
# IPv6: all but global unicast (2000::/3), which takes ::, ::1, IPv4-mapped, NAT64 64:ff9b::,
# discard 100::, ULA fc00::/7, link-local and multicast; then the special blocks inside
# 2000::/3: IETF protocol (Teredo 2001::/32 among them), documentation, 6to4.
IPAddressDeny=::/3 4000::/2 8000::/1
IPAddressDeny=2001::/23 2001:db8::/32 2002::/16 3fff::/20
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Envoy's allocator (tcmalloc) calls mincore, which @system-service leaves out.
SystemCallFilter=mincore
SystemCallFilter=~@privileged @resources
LimitCORE=0
LimitNOFILE=65536
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
