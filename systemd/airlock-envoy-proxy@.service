[Unit]
Description=airlock box socket %i -> Envoy listener %i
Documentation=https://github.com/appletalk/airlock-envoy
# Wants=, not Requires=: the relay starts Envoy when it starts, but does not stop, restart or
# fail with it. It connects to Envoy's socket afresh for each box connection, so while Envoy
# is down a box connection is just closed, and once Envoy is back the same box socket works:
# running boxes need no relaunch. (With Requires=, a box connection while Envoy was down
# failed the relay, and a burst of them failed the box socket for good.)
Wants=airlock-envoy.service
Requires=airlock-envoy-proxy@%i.socket
After=airlock-envoy.service airlock-envoy-proxy@%i.socket
# No start-rate limit: a relay that is stopped or exits is started again by the next box
# connection, however often. The socket's own trigger limit still stops a busy loop.
StartLimitIntervalSec=0

[Service]
# Envoy cannot take a listening socket from systemd, so this relays each box connection,
# byte for byte, to Envoy's own socket for the same listener.
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --connections-max=256 /run/airlock-envoy-internal/%i.sock
User=airlock-envoy
Group=airlock-envoy

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
LimitCORE=0
