[Unit]
Description=airlock box socket for Envoy listener %i
Documentation=https://github.com/appletalk/airlock-envoy
# The kill switch (airlock-envoy-apply --stop): no box socket at boot or by hand.
ConditionPathExists=!/etc/airlock-envoy/stopped

[Socket]
# Created by systemd in a root-owned directory, so neither Envoy nor anything running as
# the client can swap it for something else (claude-airlock requires exactly this). It
# outlives Envoy restarts, so running boxes keep a working socket.
ListenStream=/run/airlock-envoy/%i.sock
DirectoryMode=0755
SocketUser=airlock-envoy
SocketGroup=airlock-envoy
SocketMode=0600
# install-service.sh adds the client's uid ACL in a drop-in (ExecStartPost=setfacl ...).
# The listener's client manifest (its plain-HTTP hosts, nothing secret), public next to the
# socket and gone with it; airlock-envoy-apply keeps it in /etc and updates a running one.
ExecStartPost=-/usr/bin/install -m 0644 -o root -g root /etc/airlock-envoy/clients/%i.clients /run/airlock-envoy/%i.clients
ExecStopPost=/usr/bin/rm -f /run/airlock-envoy/%i.clients

[Install]
WantedBy=sockets.target
