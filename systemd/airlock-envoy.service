[Unit]
Description=airlock Envoy egress proxy (behind airlock-envoy-proxy@ sockets)
Documentation=https://github.com/appletalk/airlock-envoy
Wants=network-online.target
After=network-online.target
# The kill switch (airlock-envoy-apply --stop): not even a box connection starts it.
ConditionPathExists=!/etc/airlock-envoy/stopped
# Never give up restarting after failures (see RestartSteps= below).
StartLimitIntervalSec=0

[Service]
Type=simple
User=airlock-envoy
Group=airlock-envoy
# Pass credentials (airlock-envoy-cred add) live in a tmpfs: after a reboot, make each one's
# file, locked, before Envoy reads it. A no-op without pass credentials.
ExecStartPre=-+/usr/local/sbin/airlock-envoy-cred boot
# Rendered from /etc/airlock-envoy/site.conf by airlock-envoy-apply.
ExecStart=/usr/local/bin/envoy -c /etc/airlock-envoy/envoy.yaml --disable-hot-restart --file-flush-interval-msec 1000 --log-level warn
# Ready only once all of Envoy's sockets (every listener's, and admin) exist, so a start or
# restart returns when connections work and the relays (ordered after this unit) never meet a
# missing socket. A config it cannot read, or one naming no sockets, fails the start, and so
# does Envoy exiting (at once, not after the 10 s the wait allows).
ExecStartPost=/bin/sh -c 'socks=$$(grep -o "/run/airlock-envoy-internal/[a-z0-9-]*[.]sock" /etc/airlock-envoy/envoy.yaml) || exit 1; i=0; for s in $$socks; do until [ -S "$$s" ]; do kill -0 "$$MAINPID" 2>/dev/null || exit 1; i=$$((i+1)); [ $$i -lt 200 ] || exit 1; sleep 0.05; done; done'
Restart=on-failure
RestartSec=2
# Back off to a minute between tries rather than stop trying: after a crash loop Envoy comes
# back by itself once the cause is gone, and the box sockets stay up meanwhile (the relay only
# Wants= Envoy). Box egress is closed while it is down. RestartSteps= needs systemd 254 or
# later; older ones ignore it and retry every 2 s.
RestartSteps=10
RestartMaxDelaySec=60

# Envoy's own sockets, reached only by airlock-envoy-proxy@ (same account). Boxes get the
# sockets systemd creates in the root-owned /run/airlock-envoy/ instead: Envoy cannot
# rename anything there, so it cannot swap what a box is given.
RuntimeDirectory=airlock-envoy-internal
RuntimeDirectoryMode=0700
# The audit log: readable by root and this service only.
LogsDirectory=airlock-envoy
LogsDirectoryMode=0750
UMask=0077

# A crash makes Envoy dump the requests in flight to stderr, one header a line, the injected
# credential included ('authorization', 'Bearer ...'). Such lines, and any naming an
# Authorization header or a bearer token, never reach the journal (systemd 253 and later; an
# older one ignores the key, so keep its journal readers few). No quotes, spaces or backslashes
# in the pattern, so no unit-file unquoting can change it.
LogFilterPatterns=~(?i)(proxy-)?authori[sz]ation.{0,2}[:,]|bearer[[:space:]]

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Envoy's allocator (tcmalloc) calls mincore, which @system-service leaves out.
SystemCallFilter=mincore
SystemCallFilter=~@privileged @resources
LimitCORE=0
LimitNOFILE=65536
MemorySwapMax=0

[Install]
WantedBy=multi-user.target
