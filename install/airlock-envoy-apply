# Who each socket is for. One user per listener, so a socket is never shared (each user's
# boxes reach only their own listeners), and a credential is reachable by one user only.
check_clients() {
  local l d c k
  local -A cred_of=()
  for l in "${!CLIENT[@]}"; do
    [ -n "${DESTS[$l]+x}" ] || die "${CLIENT_AT[$l]}: client for '$l', which is not a listener in this file"
  done
  for l in "${LISTENERS[@]}"; do
    [ -z "${BUILT[$l]:-}" ] || continue
    if [ -n "${CLIENT[$l]:-}" ]; then SOCKETS+=("$l")
    elif [ -z "${INCLUDED_BY[$l]:-}" ]; then
      die "$site_src: listener $l has no client: add 'client $l <user>' (only a listener another one includes may go without, as a definition with no socket)"
    fi
  done
  for l in "${SOCKETS[@]}"; do
    for d in ${HDESTS[$l]:-}; do
      c=${HTTP_CRED[$d]}
      [ -n "$c" ] || continue
      k=${cred_of[$c]:-}
      if [ -z "$k" ]; then cred_of[$c]="${CLIENT[$l]} $l"
      elif [ "${k%% *}" != "${CLIENT[$l]}" ]; then
        die "$site_src: credential $c is reachable by ${k%% *} (listener ${k#* }) and by ${CLIENT[$l]} (listener $l): a credential belongs to one user; give the other a variant (http <host>@<variant>) with a credential of its own"
      fi
    done
  done
}
