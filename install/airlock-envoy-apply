key() { if [[ "$1" == *:443 ]]; then printf '%s' "${1%:443}"; else printf '%s' "$1"; fi; }
is_ip() { [[ "${1%:*}" =~ ^[0-9.]+$ ]]; }
internal_names() { printf '%s\n' "${BUILTIN_INTERNAL_NAMES[@]}" "${INTERNAL_NAMES[@]}"; }

# A web listener's routes after its exact entries: internal names and IP literals are refused
# here (the CONNECT authority), any other host name on 443 goes to the web Envoy, which checks
# the TLS server name the same way and dials only what DNS gives for it, under its own kernel
# filter. The authority and the server name may differ; each side checks its own.
web_routes() {  # web_routes <listener>
  local n
  while IFS= read -r n; do
    cat <<EOF
              - name: "deny-web-internal-$n"
                match:
                  connect_matcher: {}
                  headers: [{ name: ":authority", string_match: { exact: "$n:443", ignore_case: true } }]
                direct_response: { status: 403, body: { inline_string: "airlock-envoy: internal name, not web\\n" } }
              - name: "deny-web-internal-sub-$n"
                match:
                  connect_matcher: {}
                  headers: [{ name: ":authority", string_match: { suffix: ".$n:443", ignore_case: true } }]
                direct_response: { status: 403, body: { inline_string: "airlock-envoy: internal name, not web\\n" } }
EOF
  done < <(internal_names)
  cat <<'EOF'
              - name: allow-web
                match:
                  connect_matcher: {}
                  headers: [{ name: ":authority", string_match: { safe_regex: { regex: "(?i)[a-z0-9.-]+\\.[a-z][a-z0-9-]*:443" } } }]
EOF
  printf '                route: { cluster: "web-egress-%s", upgrade_configs: [{ upgrade_type: CONNECT, connect_config: {} }] }\n' "$1"
}

# ---- plain HTTP: presets, virtual hosts, credentials, upstreams ----------------------------
# Each preset is default-deny: these routes, in order, then 403. A line is
#   <name> <methods: regex, or * for any> <prefix|exact|regex> <path> [deny|lua|long]
# Paths are matched without the query string. long: no request timeout or stream cap (a clone
# or push can take long; the idle timeout still applies). github-api's lua line runs the GraphQL write
# check (install/github-graphql.lua) on that route: GitHub writes go through POST /graphql, so
# method and path alone can't tell a PR from a merge.
preset_rules() {
  case "$1" in
    any) echo 'any GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS prefix /' ;;   # no TRACE: it echoes headers
    git) cat <<'EOR'
info-refs GET regex /[^/]+/[^/]+/info/refs
pack POST regex /[^/]+/[^/]+/git-(upload|receive)-pack
EOR
    ;;
    git-read) cat <<'EOR'
info-refs GET regex /[^/]+/[^/]+/info/refs
pack POST regex /[^/]+/[^/]+/git-upload-pack
EOR
    ;;
    github-api) cat <<'EOR'
graphql POST exact /graphql lua
graphql-other * regex (?i)/graphql.* deny
read GET|HEAD prefix /
create POST regex /repos/[^/]+/[^/]+/(pulls|issues)
issue-sub POST regex /repos/[^/]+/[^/]+/issues/[0-9]+/(comments|labels|assignees)
edit PATCH regex /repos/[^/]+/[^/]+/(pulls|issues)/[0-9]+
edit-comment PATCH regex /repos/[^/]+/[^/]+/issues/comments/[0-9]+
reviewers POST regex /repos/[^/]+/[^/]+/pulls/[0-9]+/requested_reviewers
EOR
    ;;
    # Issues only. REST numbers PRs as issues, so these routes (and the GraphQL comment, label
    # and assignee writes) also reach a PR's comments, labels, assignees, title, body and
    # state; not its base branch, reviewers or code.
    github-issues) cat <<'EOR'
graphql POST exact /graphql lua
graphql-other * regex (?i)/graphql.* deny
read GET|HEAD prefix /
create POST regex /repos/[^/]+/[^/]+/issues
issue-sub POST regex /repos/[^/]+/[^/]+/issues/[0-9]+/(comments|labels|assignees)
edit PATCH regex /repos/[^/]+/[^/]+/issues/[0-9]+
edit-comment PATCH regex /repos/[^/]+/[^/]+/issues/comments/[0-9]+
EOR
    ;;
    # Forgejo (or Gitea) for a bot account: git fetch and push (which branches it may push is
    # the server's branch protection), API reads, PR create and edit (title, body, base, state),
    # comments, labels, reviewers on issues and PRs. Refused: merge, reviews (approve), files
    # written through the API, branches, tags, releases, settings, hooks, keys, deletes, admin.
    forgejo) cat <<'EOR'
wiki * regex /[^/]+/[^/]+\\.wiki(\\.git)?/.* deny
info-refs GET regex /[^/]+/[^/]+/info/refs long
pack POST regex /[^/]+/[^/]+/git-(upload|receive)-pack long
read GET|HEAD prefix /api/v1/
create POST regex /api/v1/repos/[^/]+/[^/]+/(pulls|issues)
issue-sub POST regex /api/v1/repos/[^/]+/[^/]+/issues/[0-9]+/(comments|labels)
edit PATCH regex /api/v1/repos/[^/]+/[^/]+/(pulls|issues)/[0-9]+
edit-comment PATCH regex /api/v1/repos/[^/]+/[^/]+/issues/comments/[0-9]+
reviewers POST regex /api/v1/repos/[^/]+/[^/]+/pulls/[0-9]+/requested_reviewers
EOR
    ;;
    # A Kubernetes API server, read only: GET and HEAD on the API and discovery paths, and
    # the two reviews that only ask what the caller is and may do (kubectl auth can-i,
    # whoami). Refused before them: any escaped character in the path (names never hold %,
    # kubectl escapes only the query and names with spaces or non-ASCII, and the API server
    # would decode %70roxy to proxy),
    # then exec, attach, port-forward and the proxy subresources, which reach into pods,
    # services and nodes (a GET can open them as a WebSocket). Reads are long (watch, logs -f).
    # What the token may read is still its RBAC.
    kubernetes-read) cat <<'EOR'
escaped * regex .*%.* deny
pod-stream * regex /api/v1/namespaces/[^/]+/(pods|services)/[^/]+/(exec|attach|portforward|proxy)(/.*)? deny
node-proxy * regex /api/v1/nodes/[^/]+/proxy(/.*)? deny
legacy-proxy * regex /api/v1/proxy(/.*)? deny
access-review POST regex /apis/authorization\\.k8s\\.io/v1/(selfsubjectaccessreviews|selfsubjectrulesreviews)
whoami POST exact /apis/authentication.k8s.io/v1/selfsubjectreviews
read GET|HEAD regex /(api|apis|openapi)(/.*)? long
version GET|HEAD exact /version
EOR
    ;;
    victoria-logs) echo 'logsql GET|POST prefix /select/logsql/' ;;
    victoria-metrics) cat <<'EOR'
query GET|POST prefix /api/v1/query
series GET|POST exact /api/v1/series
labels GET|POST exact /api/v1/labels
label-values GET regex /api/v1/label/[^/]+/values
metadata GET exact /api/v1/metadata
EOR
    ;;
  esac
}
# One repos entry as a regex for the <owner>/<repo> part of a path. Letters are written [aA]
# (GitHub and Forgejo match names in any case; RE2 and bash read that alike, so the tests
# check what Envoy runs), dots escaped, a named repo with an optional .git, <owner>/* as any
# repo name of that owner. No % fits: an escaped name is refused, not decoded.
ci_lit() {
  local s=$1 i c out=""
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in [a-z]) out+="[$c${c^^}]" ;; .) out+='\\.' ;; *) out+=$c ;; esac
  done
  printf '%s' "$out"
}
repo_regex() {  # repo_regex <owner>/<repo or *>
  local n=${1#*/}
  if [ "$n" = "*" ]; then n='[A-Za-z0-9._-]+'; else n="$(ci_lit "$n")(\\\\.git)?"; fi
  printf '(%s/%s)' "$(ci_lit "${1%%/*}")" "$n"
}
# A preset's routes under repos: each allowing route that names a repo becomes one route per
# listed repo (<name>-1, -2, ...: a regex per repo stays small, and Envoy refuses a regex
# over its RE2 program size); deny routes stay as they are, and keep their place. Reads
# outside a repo are refused but for who the token is (and, on GitHub, its rate limit).
# GraphQL is refused: one query walks from a repo to any other (parent, forks, an owner's
# repositories), so a path can't scope it; the presets' catch-all GraphQL deny then takes
# POST /graphql too. Refused first: an escaped unreserved character (letters, digits, -._~,
# which no client needs to escape: after a listed repo, %2e%2e is a dot segment the upstream
# could decode into another repo's path, and c%6fmpare would slip past the next rule; the
# listener already rejects escaped slashes), and a compare across repos (base...owner:branch
# reads another repo of the fork network by branch name), compare in any case.
preset_rules_scoped() {  # preset_rules_scoped <rules> <repos>
  local name methods kind pat flag any='[^/]+/[^/]+' i r api="" ; local -a list rxs
  read -ra list <<< "$2"   # read, not a bare $2: <owner>/* must not glob
  for r in "${list[@]}"; do rxs+=("$(repo_regex "$r")"); done
  echo 'escaped-unreserved * regex .*%(3[0-9]|[46][1-9a-fA-F]|[57][0-9aA]|2[dDeE]|5[fF]|7[eE]).* deny'
  case "$1" in github-*) api=/repos ;; forgejo) api=/api/v1/repos ;; esac
  [ -z "$api" ] || echo "compare-across * regex $api/[^/]+/[^/]+/$(ci_lit compare)/.*(:|%3[aA]).* deny"
  while read -r name methods kind pat flag; do
    [ -n "$name" ] || continue
    if [ "${flag:-}" = deny ]; then echo "$name $methods $kind $pat $flag"; continue; fi
    case "$1:$name" in
      github-*:graphql) continue ;;
      github-*:read) pat="/repos/$any(/.*)?" kind=regex
        printf '%s\n' "user GET|HEAD exact /user" "rate-limit GET|HEAD exact /rate_limit" ;;
      forgejo:read) pat="/api/v1/repos/$any(/.*)?" kind=regex
        printf '%s\n' "user GET|HEAD exact /api/v1/user" "version GET|HEAD exact /api/v1/version" ;;
    esac
    [[ "$pat" == *"$any"* ]] || die "internal: the $1 route $name has no repo part to scope"
    for i in "${!rxs[@]}"; do
      echo "$name-$((i + 1)) $methods $kind ${pat//"$any"/"${rxs[$i]}"} ${flag:-}"
    done
  done < <(preset_rules "$1")
}
CRED_DIR=/etc/airlock-envoy/credentials
CA_DIR=/etc/airlock-envoy/ca
lua_file() {  # the GraphQL check: next to this script in a checkout, else where install put it
  local f
  f="$(dirname "$(readlink -f "$0")")/github-graphql.lua"
  [ -r "$f" ] || f=/usr/local/share/airlock-envoy/github-graphql.lua
  printf '%s' "$f"
}
cas_used() {  # every ca some listener's http destinations use, once each
  local l d c seen=" "
  for l in "${SOCKETS[@]}"; do
    for d in ${HDESTS[$l]:-}; do
      c=${HTTP_CA[$d]}
      [ -n "$c" ] || continue
      case "$seen" in *" $c "*) continue ;; esac
      seen="$seen$c "; echo "$c"
    done
  done
}
creds_used() {  # every credential some listener's http destinations use, once each
  local l d c seen=" "
  for l in "${SOCKETS[@]}"; do
    for d in ${HDESTS[$l]:-}; do
      c=${HTTP_CRED[$d]}
      [ -n "$c" ] || continue
      case "$seen" in *" $c "*) continue ;; esac
      seen="$seen$c "; echo "$c"
    done
