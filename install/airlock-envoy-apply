#!/bin/bash
# airlock-envoy-apply: build Envoy's config from the site file, check it, and apply it.
#
#   airlock-envoy-apply [--yes] [SITE]   as root: apply /etc/airlock-envoy/site.conf, or SITE, a
#                                        site file kept elsewhere (say, a dotfiles repo): that
#                                        one is shown, confirmed (--yes skips) and installed as
#                                        /etc/airlock-envoy/site.conf first
#   airlock-envoy-apply --check [SITE]   parse, render and validate; show what would change
#   airlock-envoy-apply --list [SITE]    print each listener's destinations (any user)
#   airlock-envoy-apply --render [SITE]  print the Envoy config (any user)
#   airlock-envoy-apply --clients NAME [SITE]
#                                        print listener NAME's client manifest (any user)
#   airlock-envoy-apply --stop           as root: cut all box egress and keep it cut, across
#                                        applies and reboots (the kill switch)
#   airlock-envoy-apply --start          as root: lift it, apply, and start everything
#   airlock-envoy-apply --status         Envoy, the kill switch and each box socket and its user
#                                        (any user; as root also whether the site file is applied)
#
# The site file names listeners and what each may reach. A listener is a box socket for one
# user, /run/airlock-envoy/<user>/<name>.sock, and a box gets one, so a listener is a whole
# access profile. Repeat a name to continue it on another line; # starts a comment.
#
#   infra  @anthropic  metrics.example.net:443  10.0.0.10:6443
#   client infra alice
#
#   client <listener> <user>
#               the one user whose boxes may connect: the socket is in /run/airlock-envoy/<user>/
#               (root's, and only that user may enter it) and only that uid may connect to it.
#               Every listener needs exactly one, except one that another listener includes,
#               which may have none: it is then a definition only, with no socket (as is the
#               built-in anthropic). A credential may be reachable by one user's listeners
#               only: for a second user, define a variant (http <host>@<variant>) with its own.
#
#   host:port   CONNECT to exactly this host and port, and only TLS whose server name (SNI) is
#               that host passes: another site on the same address is not reachable
#   IPv4:port   CONNECT to exactly this address and port, and only TLS without a server name
#               passes (clients send none for an address). For hosts you run, not shared edges.
#   @name       everything listener <name> allows; it must be defined above. Built in:
#               anthropic, the hosts Claude Code needs (this file keeps them current).
#   web         the public internet: any host name on port 443, through a separate Envoy
#               (airlock-envoy-web) whose kernel filter refuses every non-public address.
#               An exact entry above still wins; internal names and IP literals never match.
#
# Two site-wide lines say what "internal" is, for web, beyond the built-in lists:
#
#   internal-name  corp.example  lab.example.net     names (and their subdomains) web refuses
#   internal-net   198.51.100.0/24  2001:db8:1::/48  addresses web refuses, IPv4 or IPv6 CIDR
#
# Built in: names localhost, local, localdomain, internal, lan, home.arpa; every address that
# is not public (private, loopback, link-local, CGNAT, documentation, multicast, IPv6 ULA and
# the address-mapping prefixes; the list lives in airlock-envoy-web.service).
#
# Each socket also gets a client manifest, /run/airlock-envoy/<user>/<name>.clients (0644, next
# to it): one line per plain-HTTP host, "<host> <port> <rules> <credential: yes|no>", nothing
# secret. A box launcher reads it to point the box's clients (git, gh) at http://.
set -euo pipefail
umask 077
export LC_ALL=C

ETC=/etc/airlock-envoy
ENVOY=/usr/local/bin/envoy
LOG=/var/log/airlock-envoy/access.jsonl
WEB_LOG=/var/log/airlock-envoy/web.jsonl
WEB_DROPIN=/etc/systemd/system/airlock-envoy-web.service.d/site.conf
SOCK_DIR=/run/airlock-envoy   # box sockets: <user>/<listener>.sock, one directory per user
BUILTIN_INTERNAL_NAMES=(localhost local localdomain internal lan home.arpa)
BUILTIN='anthropic api.anthropic.com:443 platform.claude.com:443'
PER_LISTENER=128   # connections from boxes at once, per listener (so per profile)

die() { echo "airlock-envoy-apply: $*" >&2; exit 1; }

mode=apply yes=0 start=0 clients_of=
while [ $# -gt 0 ]; do
  case "$1" in
    --check|--list|--render|--render-web|--render-web-dropin|--stop|--status) mode=${1#--} ;;
    --clients|--render-socket-dropin)
               [ $# -ge 2 ] || { echo "airlock-envoy-apply: $1 needs a listener name" >&2; exit 1; }
               mode=${1#--} clients_of=$2; shift ;;
    --start) mode=apply start=1 ;;
    --yes) yes=1 ;;
    --restart) restart=1 ;;   # install-service.sh: the unit may have changed; start egress
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $1 (see --help)" ;;
    *) break ;;
  esac
  shift
done
[ $# -le 1 ] || die "one site file at most"
site_arg="${1:-}"
restart="${restart:-0}"
STOPPED="$ETC/stopped"   # the kill switch; the units do not start while it exists

lock() {  # one apply at a time: two would interleave the .new files and the rollback copy
  [ "$(id -u)" = 0 ] || die "run as root (or --check / --list / --render)"
  exec 9>>/run/airlock-envoy-apply.lock
  flock -n 9 || die "another airlock-envoy-apply is running"
}
if [ "$mode" = stop ]; then
  # No lock: an apply waiting at its prompt must not delay this, and once the marker exists
  # any concurrent start is a no-op (ConditionPathExists).
  [ $# = 0 ] || die "--stop takes no site file"
  [ "$(id -u)" = 0 ] || die "run as root"
  [ -d "$ETC" ] || die "$ETC does not exist: nothing installed"
  install -m 0644 -o root -g root /dev/null "$STOPPED"
  systemctl stop 'airlock-envoy-proxy@*.socket' 'airlock-envoy-proxy@*.service' airlock-envoy
  systemctl stop airlock-envoy-web 2>/dev/null || true   # not installed by older versions
  echo "==> Box egress stopped: Envoy and every box socket are down, and stay down across applies,"
  echo "    deploys and reboots ($STOPPED). Resume: airlock-envoy-apply --start"
  echo "    (new socket files, so running boxes need a relaunch)"
  exit 0
fi

# ---- parse ----------------------------------------------------------------------------------

declare -A DESTS=() INCLUDED_BY=() IN_ALL=() BUILT=() WEB=()
declare -A HDESTS=() HTTP_RULES=() HTTP_CRED=() HTTP_PORT=() HTTP_HOST=() HTTP_PROJECTS=() HTTP_CA=() HTTP_REPOS=()
declare -A CLIENT=() CLIENT_AT=() CLIENT_UID=()
LISTENERS=() ALL=() INTERNAL_NAMES=() INTERNAL_NETS=() HTTP_HOSTS=()
SOCKETS=()   # the listeners with a client, in file order: each gets a box socket
PRESETS="any forgejo git git-read github-api github-issues kubernetes-read victoria-logs victoria-metrics"

valid_dest() {
  local h p o='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])'
  [[ "$1" =~ ^([a-z0-9.-]+):([0-9]+)$ ]] || return 1
  h=${BASH_REMATCH[1]} p=${BASH_REMATCH[2]}
  [[ "$p" =~ ^[1-9][0-9]{0,4}$ ]] && [ "$p" -le 65535 ] || return 1
  if [[ "$h" =~ ^[0-9.]+$ ]]; then
    [[ "$h" =~ ^$o\.$o\.$o\.$o$ ]] || return 1
    # The host's own loopback, "this network", link-local (cloud metadata lives there) and
    # multicast/reserved: never a destination.
    case "$h" in 0.*|127.*|169.254.*) return 1 ;; esac
    [ "${h%%.*}" -lt 224 ]
  else
    [ "${#h}" -le 253 ] && [[ "$h" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$ ]]
  fi
}

valid_name_suffix() {  # a domain name, one label or more
  [ "${#1}" -le 253 ] && [[ "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z]([a-z0-9-]{0,61}[a-z0-9])?$ ]]
}

# An IPv4 or IPv6 CIDR, strictly: systemd skips an entry it cannot parse, and a skipped deny
# fails open.
valid_cidr() {
  local a=${1%/*} p=${1##*/} o='(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])' g cnt=0
  local -a groups
  [[ "$1" == */* ]] && [[ "$p" =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
  if [[ "$a" =~ ^$o\.$o\.$o\.$o$ ]]; then [ "$p" -le 32 ]; return; fi
  [ "$p" -le 128 ] && [[ "$a" =~ ^[0-9a-f:]+$ ]] && [[ "$a" == *:*:* ]] || return 1
  case "$a" in *::*::*|*:::*) return 1 ;; esac
  if [[ "$a" == :* && "$a" != ::* ]] || [[ "$a" == *: && "$a" != *:: ]]; then return 1; fi
  IFS=: read -ra groups <<< "$a"
  for g in "${groups[@]}"; do
    [ -n "$g" ] || continue
    [[ "$g" =~ ^[0-9a-f]{1,4}$ ]] || return 1
    cnt=$((cnt + 1))
  done
  if [[ "$a" == *::* ]]; then [ "$cnt" -le 7 ]; else [ "$cnt" -eq 8 ]; fi
}

add_unique() {  # add_unique <array name> <value>
  local -n arr=$1
  local v
  for v in "${arr[@]}"; do [ "$v" = "$2" ] && return; done
  arr+=("$2")
}

add_dest() {
  case " ${DESTS[$1]} " in *" $2 "*) return ;; esac
  DESTS[$1]="${DESTS[$1]:+${DESTS[$1]} }$2"
  [ -n "${IN_ALL[$2]:-}" ] || { IN_ALL[$2]=1; ALL+=("$2"); }
}

parse() {  # parse <source label>, text on stdin
  local src=$1 n=0 line name w d charset_ok chk
  local -a words
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%%#*}
    charset_ok=1
    # Project IDs and repo names (an http line's "projects" and "repos" values) may be mixed
    # case and hold _, / and *; parse_http checks them.
    chk=$line
    if [[ "$line" =~ ^[[:blank:]]*http[[:blank:]] ]]; then
      while [[ "$chk" =~ (^|[[:blank:]])(projects|repos)[[:blank:]]+[^[:blank:]]+ ]]; do chk=${chk/"${BASH_REMATCH[0]}"/ }; done
    fi
    # User names may have an underscore; the client line checks its words itself.
    [[ ! "$line" =~ ^[[:blank:]]*client[[:blank:]] ]] || chk=${chk//_/}
    [[ "$chk" =~ ^[a-z0-9.:@/[:blank:]-]*$ ]] || charset_ok=0
    # A slash only in http:// destinations and in internal-net CIDRs.
    if [[ "${chk//http:\/\//}" == */* ]] && ! [[ "$line" =~ ^[[:blank:]]*internal-net[[:blank:]] ]]; then charset_ok=0; fi
    [ "$charset_ok" = 1 ] \
      || die "$src:$n: only lowercase listener names, host:port, IPv4:port, http://host, @listener and web (and CIDRs on internal-net lines) may appear"
    read -ra words <<< "$line"
    [ "${#words[@]}" -gt 0 ] || continue
    name=${words[0]}
    case "$name" in
      internal-name|internal-net)
        [ "${#words[@]}" -gt 1 ] || die "$src:$n: $name lists nothing"
        for w in "${words[@]:1}"; do
          if [ "$name" = internal-name ]; then
            valid_name_suffix "$w" || die "$src:$n: bad internal name '$w' (want a domain, e.g. corp.example)"
            add_unique INTERNAL_NAMES "$w"
          else
            valid_cidr "$w" || die "$src:$n: bad internal network '$w' (want an IPv4 or IPv6 CIDR, e.g. 198.51.100.0/24)"
            add_unique INTERNAL_NETS "$w"
          fi
        done
        continue ;;
      http) parse_http "$src:$n" "${words[@]:1}"; continue ;;
      client)
        [ "${#words[@]}" = 3 ] || die "$src:$n: want: client <listener> <user>"
        [[ "${words[1]}" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || die "$src:$n: bad listener name '${words[1]}'"
        # A login name as shadow-utils and Debian allow them (no trailing $: machine accounts).
        [[ "${words[2]}" =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]] || die "$src:$n: bad user name '${words[2]}'"
        [ -z "${BUILT[${words[1]}]:-}" ] \
          || die "$src:$n: ${words[1]} is built in and has no socket; define your own (say, ${words[2]}-${words[1]} @${words[1]}) and name its client"
        [ -z "${CLIENT[${words[1]}]+x}" ] \
          || die "$src:$n: listener ${words[1]} already has a client (${CLIENT[${words[1]}]}, at ${CLIENT_AT[${words[1]}]}): one listener, one user; give each user a listener of its own"
        CLIENT[${words[1]}]=${words[2]} CLIENT_AT[${words[1]}]=$src:$n
        continue ;;
      web) die "$src:$n: 'web' is a destination, not a listener name" ;;
    esac
    [[ "$name" =~ ^[a-z][a-z0-9-]{0,31}$ ]] \
      || die "$src:$n: bad listener name '$name' (a-z, 0-9 and -, starting with a letter, up to 32)"
    [ "$name" != admin ] || die "$src:$n: 'admin' is reserved (Envoy's admin socket)"
    [ -z "${BUILT[$name]:-}" ] || die "$src:$n: $name is built in; include it with @$name instead"
    [ -z "${INCLUDED_BY[$name]:-}" ] \
      || die "$src:$n: $name is already included by ${INCLUDED_BY[$name]}; keep all of $name's lines above that"
    [ "${#words[@]}" -gt 1 ] || die "$src:$n: listener $name lists nothing"
    [ -n "${DESTS[$name]+x}" ] || { LISTENERS+=("$name"); DESTS[$name]=; }
    for w in "${words[@]:1}"; do
      if [[ "$w" == @* ]]; then
        w=${w#@}
        [[ "$w" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || die "$src:$n: bad include '@$w' (want @listener)"
        [ "$w" != "$name" ] || die "$src:$n: $name includes itself"
        [ -n "${DESTS[$w]+x}" ] || die "$src:$n: @$w is not a listener defined above"
        INCLUDED_BY[$w]=$name
        for d in ${DESTS[$w]}; do add_dest "$name" "$d"; done
        for d in ${HDESTS[$w]:-}; do add_hdest "$name" "$d"; done
        [ -z "${WEB[$w]:-}" ] || WEB[$name]=1
      elif [ "$w" = web ]; then
        WEB[$name]=1
      elif [[ "$w" == http://* ]]; then
        d=${w#http://}
        [ -n "${HTTP_RULES[$d]+x}" ] || die "$src:$n: $w has no 'http $d ...' line above it"
        add_hdest "$name" "$d"
      else
        valid_dest "$w" || die "$src:$n: bad destination '$w' (want host:port or IPv4:port)"
        add_dest "$name" "$w"
      fi
    done
  done
  # One mode per host and listener: a host reached by plain HTTP (rules, credential) must not
  # also be a CONNECT entry, or a box could tunnel around the rules. And one definition of a
  # host per listener: its requests can only go one way.
  local l h k seen
  for l in "${LISTENERS[@]}"; do
    seen=" "
    for k in ${HDESTS[$l]:-}; do
      h=${HTTP_HOST[$k]}
      case "$seen" in *" $h "*) die "$src: listener $l lists $h twice (as http://$k and another); use one" ;; esac
      seen="$seen$h "
      for d in ${DESTS[$l]}; do
        [ "${d%:*}" != "$h" ] || die "$src: listener $l lists $h both as http://$k and as $d; use one"
      done
    done
  done
}

# http <host>[:port][@variant] rules <preset> [credential <name>] [ca <name>] [projects <id>[,<id>...]]
#   [repos <owner>/<repo>[,...]]:
# how the box reaches a host by plain HTTP. Envoy answers the box, checks method and path
# against the preset, adds the credential, and is the TLS client to the host (its certificate
# checked, Host and SNI fixed). The host may be an IPv4 address (a Kubernetes API server, say):
# then no SNI, and the certificate must name that address. ca: the host's certificate is
# checked against $CA_DIR/<name>.pem alone, not the system CAs (a cluster's own CA). A variant
# is another definition of the same host (its own rules and credential, e.g. a second
# identity), listed as http://<host>@<variant>; a listener uses one definition per host.
# projects (GitHub presets only) lets Projects v2 item writes through for those project node
# IDs and no others. repos (the git, forgejo and GitHub presets) narrows every repo route to
# those repos (<owner>/<repo>, or <owner>/* for all of an owner's), and refuses GraphQL.
parse_http() {  # parse_http <where> <words...>
  local where=$1 hp host port variant="" k rules="" cred="" ca="" projects="" repos="" id r; local -a ids; shift
  [ $# -ge 3 ] || die "$where: want: http <host>[:port][@variant] rules <preset> [credential <name>] [ca <name>] [projects <id>,...] [repos <owner>/<repo>,...]"
  hp=$1; shift
  if [[ "$hp" == *@* ]]; then
    variant=${hp#*@} hp=${hp%%@*}
    [[ "$variant" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || die "$where: bad variant '@$variant' (a-z, 0-9 and -, starting with a letter, up to 32)"
  fi
  host=${hp%:*}; port=443; [[ "$hp" == *:* ]] && port=${hp##*:}
  valid_dest "$host:$port" || die "$where: bad http host '$hp' (want a host name or IPv4 address, optionally :port)"
  k=$host${variant:+@$variant}
  [ -z "${HTTP_RULES[$k]+x}" ] || die "$where: http $k is defined twice"
  while [ $# -gt 0 ]; do
    case "$1" in
      rules) [ $# -ge 2 ] || die "$where: rules needs a preset"; rules=$2; shift 2 ;;
      credential) [ $# -ge 2 ] || die "$where: credential needs a name"; cred=$2; shift 2 ;;
      ca) [ $# -ge 2 ] || die "$where: ca needs a name"; ca=$2; shift 2 ;;
      projects) [ $# -ge 2 ] || die "$where: projects needs project IDs"
        [[ "$2" != *, ]] || die "$where: bad project ID '' (a trailing comma)"
        IFS=, read -ra ids <<< "$2"
        for id in "${ids[@]}"; do
          [[ "$id" =~ ^PVT_[A-Za-z0-9_-]{1,64}$ ]] || die "$where: bad project ID '$id' (want a Projects v2 node ID, PVT_...)"
          case " $projects " in *" $id "*) ;; *) projects="${projects:+$projects }$id" ;; esac
        done
        shift 2 ;;
      repos) [ $# -ge 2 ] || die "$where: repos needs <owner>/<repo> names"
        [ -z "$repos" ] || die "$where: repos given twice"
        [[ "$2" != *, ]] || die "$where: bad repo '' (a trailing comma)"
        IFS=, read -ra ids <<< "$2"
        for r in "${ids[@]}"; do
          valid_repo "$r" || die "$where: bad repo '$r' (want <owner>/<repo> or <owner>/*)"
          r=${r,,}
          case " $repos " in *" $r "*) ;; *) repos="${repos:+$repos }$r" ;; esac
        done
        [ "${#ids[@]}" -le 64 ] || die "$where: over 64 repos"
        shift 2 ;;
      *) die "$where: unknown http option '$1' (rules, credential, ca, projects, repos)" ;;
    esac
  done
  case " $PRESETS " in *" $rules "*) ;; *) die "$where: unknown rules '$rules' (one of: $PRESETS)" ;; esac
  [ -z "$cred" ] || [[ "$cred" =~ ^[a-z][a-z0-9-]{0,62}$ ]] || die "$where: bad credential name '$cred'"
  [ -z "$ca" ] || [[ "$ca" =~ ^[a-z][a-z0-9-]{0,62}$ ]] || die "$where: bad ca name '$ca'"
  case "$rules" in github-api|github-issues) ;; *) [ -z "$projects" ] || die "$where: projects only with the github-api or github-issues rules" ;; esac
  case "$rules" in git|git-read|forgejo|github-api|github-issues) ;; *) [ -z "$repos" ] || die "$where: repos only with the git, git-read, forgejo, github-api or github-issues rules" ;; esac
  # Projects writes go through GraphQL, which repos refuses: one line can't have both.
  [ -z "$repos" ] || [ -z "$projects" ] || die "$where: repos and projects can't be on one line (repos refuses GraphQL, which Projects writes need)"
  HTTP_RULES[$k]=$rules HTTP_CRED[$k]=$cred HTTP_PORT[$k]=$port HTTP_HOST[$k]=$host HTTP_PROJECTS[$k]=$projects HTTP_CA[$k]=$ca HTTP_REPOS[$k]=$repos
  HTTP_HOSTS+=("$k")
}
# A repos entry: <owner>/<repo> or <owner>/*, names as GitHub and Forgejo allow them (owners up
# to 40 characters, repos up to 100; matched in any case). No . or .. repo, and no .git or .wiki ending (the .git is optional in git paths; a
# wiki is another repo).
valid_repo() {
  local o=${1%%/*} n=${1#*/}
  [[ "$1" == */* ]] && [[ "$o" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]{0,38}[A-Za-z0-9])?$ ]] || return 1
  [ "$n" = "*" ] && return 0
  [[ "$n" =~ ^[A-Za-z0-9._-]{1,100}$ ]] && [[ ! "$n" =~ ^\.\.?$ ]] && [[ ! "${n,,}" =~ \.(git|wiki)$ ]]
}
hid() { printf '%s' "${1/@/_}"; }   # a definition's name in Envoy (vhost, routes, cluster)
any_repos() {  # some http line has repos
  local k
  for k in "${HTTP_HOSTS[@]}"; do [ -z "${HTTP_REPOS[$k]}" ] || return 0; done
  return 1
}

add_hdest() {
  case " ${HDESTS[$1]:-} " in *" $2 "*) return ;; esac
  HDESTS[$1]="${HDESTS[$1]:+${HDESTS[$1]} }$2"
}

# Read the site file once, as root too, and use only that copy from here on.
site_src="$ETC/site.conf" site_text="" from_elsewhere=0
if [ -n "$site_arg" ]; then
  if ! [ -r "$site_arg" ] || [ -d "$site_arg" ]; then die "cannot read $site_arg"; fi
  site_src="$site_arg"
  # Only the literal /etc path counts as /etc: a path that merely resolves there (a symlink
  # someone else can repoint between this check and the read) is from elsewhere.
  [ "$site_arg" = "$ETC/site.conf" ] || from_elsewhere=1
fi
status_units() {  # what systemd and /run say; needs no access to $ETC (nor, as root, D-Bus)
  local l st acl
  st="$(systemctl is-active airlock-envoy 2>/dev/null || true)"
  echo "==> Envoy: ${st:-unknown (systemd not reachable as $(id -un))}"
  st="$(systemctl is-active airlock-envoy-web 2>/dev/null || true)"
  echo "==> Web Envoy: ${st:-unknown} (runs while a listener lists web)"
  if [ -x "$ETC" ]; then
    if [ -e "$STOPPED" ]; then echo "==> Kill switch: ON ($STOPPED; airlock-envoy-apply --start lifts it)"
    else echo "==> Kill switch: off"; fi
  else echo "==> Kill switch: unknown (run as root)"; fi
  echo "==> Box sockets:"
  # The socket units systemd knows (with the path each listens on), and the socket files there
  # are (a user without D-Bus sees only the files, and only in a directory it may enter: its own).
  local p u f
  local -A path=()
  while read -r l p; do
    [[ "$l" =~ ^[a-z][a-z0-9-]*$ ]] || continue
    [ -n "${path[$l]:-}" ] || path[$l]=$p
  done < <({
    systemctl list-units --all --plain --no-legend 'airlock-envoy-proxy@*.socket' 2>/dev/null | awk '{ print $1 }' \
      | sed -n 's/^airlock-envoy-proxy@\([a-z][a-z0-9-]*\)\.socket$/\1/p' | while read -r l; do
        printf '%s %s\n' "$l" "$(systemctl show -p Listen --value "airlock-envoy-proxy@$l.socket" 2>/dev/null | awk '{ print $1; exit }')"
      done || true
    for f in "$SOCK_DIR"/*/*.sock "$SOCK_DIR"/*.sock; do [ -S "$f" ] && printf '%s %s\n' "$(basename "$f" .sock)" "$f"; done
  } | sort)
  for l in $(printf '%s\n' "${!path[@]}" | sort); do
    p=${path[$l]:-} u=
    st="$(systemctl is-active "airlock-envoy-proxy@$l.socket" 2>/dev/null || true)"
    [[ "$p" == "$SOCK_DIR"/*/"$l.sock" ]] && u=${p#"$SOCK_DIR"/} u=${u%%/*}
    if [ -n "$p" ] && [ -d "${p%/*}" ] && ! [ -x "${p%/*}" ]; then
      st="${st:-unknown} (${p%/*} is not yours to enter)"
    elif [ -z "$p" ] || ! [ -S "$p" ]; then st="${st:-gone} (no socket file)"; fi
    acl="$(getfacl -cp "$p" 2>/dev/null | sed -n 's/^user:\([^:][^:]*\):rw-$/\1/p' | tr "\n" " " || true)"
    printf '    %-48s %-10s %s\n' "${p:-$l (no path)}" "${st:-unknown}" "${u:+user: $u}${acl:+, ACL: $acl}"
  done
}
