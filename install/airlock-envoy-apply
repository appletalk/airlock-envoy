# The users must exist and be ordinary accounts; the ACLs name them by uid, never by name.
# A uid inside another user's subordinate range (/etc/subuid) is refused: that user's rootless
# containers can take it on, and with it the client's sockets. Each problem is printed;
# BAD lists the listeners with one, and the return is 1 if there are any.
# Numbers as shadow reads them (strtoul, base 0): decimal, 0x hex, 0 octal.
subuid_num() { [[ "$1" =~ ^(0[xX][0-9a-fA-F]{1,8}|0[0-7]{0,11}|[1-9][0-9]{0,9})$ ]] && printf '%d' "$(( $1 ))"; }
subuid_unparsed() {  # the /etc/subuid lines this script could not read as shadow does (none: 1)
  local o st c line n=0 bad=1
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1)); line=${line%$'\r'}
    [[ "$line" =~ ^[[:blank:]]*$ ]] && continue
    IFS=: read -r o st c <<< "$line"
    if [ -z "$o" ] || ! subuid_num "${st//[[:blank:]]/}" >/dev/null || ! subuid_num "${c//[[:blank:]]/}" >/dev/null; then
      echo "/etc/subuid:$n: $line"; bad=0
    fi
  done < <(cat /etc/subuid 2>/dev/null)
  return "$bad"
}
uid_in_subuid() {  # uid_in_subuid <uid> <user> [<uid>]: another user's range holding uid, if any
  local o st c
  while IFS=: read -r o st c; do
    if ! st="$(subuid_num "${st//[[:blank:]]/}")" || ! c="$(subuid_num "${c//[[:blank:]]/}")"; then continue; fi
    [ "$o" != "$2" ] && [ "$o" != "${3:-x}" ] || continue
    if (( $1 >= st && $1 < st + c )); then printf '%s (%s-%s)' "$o" "$st" "$((st + c - 1))"; return 0; fi
  done < <(tr -d '\r' < /etc/subuid 2>/dev/null)
  return 1
}
BAD=()
resolve_clients() {
  local l u ent uid uid_min uid_max r why
  uid_min="$(awk '$1 == "UID_MIN" { print $2 }' /etc/login.defs 2>/dev/null)"
  case "$uid_min" in ''|*[!0-9]*) uid_min=1000 ;; esac
  uid_max="$(awk '$1 == "UID_MAX" { print $2 }' /etc/login.defs 2>/dev/null)"
  case "$uid_max" in ''|*[!0-9]*) uid_max=60000 ;; esac
  BAD=()
  # A line this can't read is a range it can't check: refuse (nothing is stopped for it).
  if r="$(subuid_unparsed)"; then
    printf 'airlock-envoy-apply: cannot read these /etc/subuid lines, so no client can be checked against them:\n%s\n' "$r" >&2
    return 1
  fi
  # The service account owns every socket: no one's containers may become it.
  if uid="$(id -u airlock-envoy 2>/dev/null)" && r="$(uid_in_subuid "$uid" airlock-envoy)"; then
    echo "airlock-envoy-apply: the airlock-envoy account (uid $uid) lies in $r's subordinate uids: $r could reach every socket" >&2
    BAD=("${SOCKETS[@]}"); return 1
  fi
  for l in "${SOCKETS[@]}"; do
    u=${CLIENT[$l]} why=
    if ! ent="$(getent passwd -- "$u" 2>/dev/null)"; then why="no such user"
    # The entry must be that name's own (a directory service may answer for another spelling).
    elif [ "${ent%%:*}" != "$u" ]; then why="the user database answers as '${ent%%:*}'"
    else
      uid="$(cut -d: -f3 <<< "$ent")"
      if ! [[ "$uid" =~ ^[0-9]+$ ]]; then why="bad uid '$uid'"
      elif [ "$uid" = 0 ] || [ "$uid" = 65534 ] || [ "$uid" -lt "$uid_min" ] || [ "$uid" -gt "$uid_max" ]; then
        why="uid $uid: only a login account (uid $uid_min to $uid_max, not root or nobody) may be a client"
      elif r="$(uid_in_subuid "$uid" "$u" "$uid")"; then
        why="uid $uid lies in $r's subordinate uids (/etc/subuid): its containers could act as $u"
      fi
    fi
    if [ -n "$why" ]; then echo "airlock-envoy-apply: ${CLIENT_AT[$l]}: client $u of $l: $why" >&2; BAD+=("$l"); continue; fi
    CLIENT_UID[$l]=$uid
  done
  [ "${#BAD[@]}" = 0 ]
}

listing() {
  local l d
  for l in "${LISTENERS[@]}"; do
    for d in ${DESTS[$l]}; do printf '%s %s\n' "$l" "$d"; done
    for d in ${HDESTS[$l]:-}; do
      printf '%s http://%s:%s%s rules %s%s%s%s%s\n' "$l" "${HTTP_HOST[$d]}" "${HTTP_PORT[$d]}" "$([[ "$d" != *@* ]] || printf ' variant %s' "${d#*@}")" "${HTTP_RULES[$d]}" \
        "${HTTP_CRED[$d]:+ credential ${HTTP_CRED[$d]}}" "${HTTP_CA[$d]:+ ca ${HTTP_CA[$d]}}" "${HTTP_PROJECTS[$d]:+ projects ${HTTP_PROJECTS[$d]// /,}}" \
        "${HTTP_REPOS[$d]:+ repos ${HTTP_REPOS[$d]// /,}}"
    done
