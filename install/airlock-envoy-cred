      [ "$tofile" = 1 ] || die "$name is a pass credential: its secret is the pass entry (airlock-envoy-cred unlock). To make it a file credential instead (the secret then on disk, never locked): set $name --file, which applies"
      [ -n "$fmt" ] || fmt=$(pass_field "$name" format)
    fi
    [ -n "$fmt" ] || fmt=bearer
    if [ -t 0 ]; then read -rs -p "Secret for $name: " secret; echo >&2
    else secret="$(cat)"; secret=${secret%$'\n'}; fi
    [ -n "$secret" ] || die "empty secret"
