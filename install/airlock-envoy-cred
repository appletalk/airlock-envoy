  boot)
    # Before Envoy starts: every pass credential has a file (locked, after a reboot); an unlock
    # still within its deadline keeps its timer running, anything else locks.
    for n in $(pass_names); do [ -f "$SEC/$n.yaml" ] || write "$SEC" "$n" "$LOCKED $n" locked; done
    # App tokens: each line's file (locked or unavailable until minted), then a mint run.
    if [ -s "$MINT_CONF" ]; then
      mark_missing "$MINT_CONF"
      systemctl start --no-block "$MINT_SVC" 2>/dev/null || true
    fi
    [ -n "$(pass_names)$(app_pass_in_use)" ] || exit 0
    dl=$(sed -n 's/^deadline //p' "$STATE" 2>/dev/null || true); bdl=$(sed -n 's/^boot_deadline //p' "$STATE" 2>/dev/null || true)
    if grep -q '^unlocked' "$STATE" 2>/dev/null && [[ "$dl" =~ ^[0-9]+$ && "$bdl" =~ ^-?[0-9]+$ ]] \
       && [ "$(now)" -lt "$dl" ] && [ "$(boot_secs)" -lt "$bdl" ] && systemctl start "$TIMER"; then :
    else lock_all nowait; fi ;;
  status)
    if [ -f "$STATE" ]; then state_summary; else echo "no state (no pass credential since boot)"; fi
    shopt -s nullglob
    for f in "$DIR"/*.yaml; do printf 'credential %s file\n' "$(basename "$f" .yaml)"; done
    for n in $(pass_names); do
      printf 'credential %s pass %s (%s)%s\n' "$n" "$(pass_field "$n" entry)" \
        "$(grep -q "inline_string: \"$LOCKED " "$SEC/$n.yaml" 2>/dev/null && echo locked || echo unlocked)" \
        "$(! grep -qF "path: \"$DIR/$n.yaml\"" "$ENVOY_YAML" 2>/dev/null || echo "; the applied config still reads the file: run airlock-envoy-apply")"
    done
    for f in "$APPS"/*; do
      a=$(basename "$f"); [[ "$a" != *.pem ]] || continue
      k=$(app_field "$a" key)
      printf 'app %s key %s%s\n' "$a" "$k" "$([ "$k" != pass ] || { [ -f "$MKEYS/$a.pem" ] && echo " (unlocked)" || echo " (locked)"; })"
      while read -r t ta; do
        [ "$ta" = "$a" ] || continue
        printf '  token %s: %s\n' "$t" "$(mint_state "$t")"
      done < <(app_tokens)
    done
    # Each App against its installation (needs the key: a locked one says so).
    if [ -s "$MINT_CONF" ]; then
      echo "==> airlock-envoy-mint check:"
      timeout 120 setpriv --reuid="$MINT_USER" --regid="$MINT_USER" --clear-groups --no-new-privs -- "$(mint_tool)" check 2>&1 7<&- 9>&- | sed 's/^/    /' || true
    fi ;;
  set)
    [ $# -ge 1 ] || die "usage: airlock-envoy-cred set <name> [--format bearer|token|raw|basic:<user>] [--file]"
    name=$1; shift; valid_name "$name"
    ! is_app "$name" || die "$name is a GitHub App (airlock-envoy-cred remove $name, once no line uses it)"
    # An earlier set --file stopped before it finished (killed): it is a pass credential again,
    # and this set needs --file to finish the move.
    if [ -f "$PASS_DIR/.$name.set" ] && ! is_pass "$name"; then
      run_dirs; exec 9> "$RUN/.lock"; flock 9
      [ ! -f "$PASS_DIR/.$name.set" ] || is_pass "$name" || mv -f "$PASS_DIR/.$name.set" "$PASS_DIR/$name"
      exec 9>&-
      echo "airlock-envoy-cred: an earlier set --file of $name did not finish: it is a pass credential again" >&2
    fi
