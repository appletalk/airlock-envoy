    while [ $# -gt 0 ]; do
      case "$1" in
        --format) [ $# -ge 2 ] || die "--format needs a value"; fmt=$2; shift 2 ;;
        --file) tofile=1; shift ;;
        *) die "unknown arguments: $* (want --format <format>, --file)" ;;
      esac
    done
